{
  /**
   * The build-time configs, checked separately from `tsconfig.json`.
   *
   * They need Node's types, and TypeScript applies global declarations to the whole
   * program: pulling `@types/node` into the app's config would make `process`, `Buffer`
   * and friends type-check in browser code that cannot use them.
   */
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Node runs `scripts/*.ts` directly and strips the types, so imports keep their `.ts`.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "svelte.config.ts", "scripts/**/*.ts"]
}
